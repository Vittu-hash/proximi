{
  "name": "proximi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,tsx}": [
      "eslint --config apps/api/eslint.config.js --max-warnings=0"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --config apps/web/eslint.config.js --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3"
  }
}
